# Kernel configurations for DroidSpaces support on Samsung Galaxy Z Flip3 (b2q / GKI 5.4)
# Designed to be kABI-safe with patches 001 and 002 applied.

# Core IPC & Namespaces
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y

# Networking & Enhanced NAT
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Tethering & TTL targets
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_MATCH_HL=y

# Firewall (UFW & Fail2ban)
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Filesystem & POSIX ACL / xattr (NixOS / OverlayFS)
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# NOTE ON RESOURCE LIMITS:
# CONFIG_CFS_BANDWIDTH and CONFIG_CGROUP_PIDS are intentionally left disabled.
# On GKI 5.4, enabling them alters scheduler/cgroup structure layouts which breaks
# modversions CRC for thousands of vendor module symbols (bootloop risk).
