# Kernel configurations for DroidSpaces support on Samsung Galaxy Z Flip3 (b2q / GKI 5.4)
# Designed to be kABI-safe with patches 001 and 002 applied.
#
# STRATEGY (after debugging of touch/ADB failure on first flash):
# 1. LOCALVERSION must remain "-Columbina" so the new kernel has the same vermagic
#    as the vendor modules in /vendor_dlkm. Otherwise modversions check rejects them.
# 2. ALL touchscreen drivers for the Z Flip3 (stm_fold) must be built-in (=y), NOT module (=m).
#    Otherwise they fail to load from /vendor_dlkm and the screen goes dead.
# 3. CONFIG_BRIDGE_NETFILTER and other structurally-invasive netfilter options are removed
#    because they shift kernel enums (skb_ext_id, etc.) and break module symbol CRCs.

# Core IPC & Namespaces
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y

# Networking & Enhanced NAT (GKI-safe subset only)
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_MACVLAN=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# Tethering & TTL targets (kABI-safe on 5.4)
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_NETFILTER_XT_MATCH_HL=y

# Firewall (UFW & Fail2ban)
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# Filesystem & POSIX ACL / xattr (NixOS / OverlayFS)
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ==============================================================================
# TOUCHSCREEN DRIVERS (built-in so they don't depend on /vendor_dlkm modules)
# The Z Flip3 stm_fold driver stack MUST be =y, not =m, otherwise the screen
# goes dead after flashing a new kernel image.
# ==============================================================================
CONFIG_INPUT_SEC_INPUT=y
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y
CONFIG_TOUCHSCREEN_DUAL_FOLDABLE=y
CONFIG_TOUCHSCREEN_STM=y

# NOTE ON RESOURCE LIMITS:
# CONFIG_CFS_BANDWIDTH and CONFIG_CGROUP_PIDS are intentionally left disabled.
# On GKI 5.4, enabling them alters scheduler/cgroup structure layouts which breaks
# modversions CRC for thousands of vendor module symbols (bootloop risk).